{
  "name": "vue-nuxt",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.1",
  "engines": {
    "node": "24.16.0",
    "pnpm": "10.34.1"
  },
  "scripts": {
    "preinstall": "npx -y only-allow@1.2.2 pnpm",
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "uiux": "storybook dev -p 6006 -c uiux",
    "build:uiux": "storybook build -c uiux -o .storybook",
    "run:uiux": "http-server .storybook --port 6006",
    "check:uiux": "test-storybook --config-dir uiux --ci --maxWorkers=2",
    "lint:format": "prettier --check --config prettier.config.js .",
    "lint:style": "stylelint --config stylelint.config.mjs **/*.css",
    "lint:script": "eslint --config eslint.config.js",
    "fix:format": "prettier --write --config prettier.config.js .",
    "fix:style": "stylelint --fix --config stylelint.config.mjs **/*.css",
    "fix:script": "eslint --fix --config eslint.config.js",
    "test:uiux": "concurrently -k -s first -n \"SB,TEST\" -c \"magenta,blue\" \"pnpm uiux\" \"wait-on tcp:6006 && pnpm check:uiux\"",
    "test:unit": "vitest --config unit/vitest.config.ts",
    "test:coverage": "vitest --run --coverage --config unit/vitest.config.ts",
    "test:e2e": "playwright test --config e2e/playwright.config.ts",
    "prepare": "husky install && playwright install"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.0",
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^10.0.1",
    "@pinia/nuxt": "^0.11.3",
    "@playwright/test": "^1.60.0",
    "@storybook/test-runner": "^0.24.4",
    "@storybook/vue3-vite": "^10.4.1",
    "@tailwindcss/cli": "^4.3.0",
    "@tailwindcss/vite": "^4.3.0",
    "@types/lodash": "^4.17.24",
    "@types/node": "^25.9.1",
    "@vite-pwa/nuxt": "^1.1.1",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vitest/coverage-v8": "^4.1.7",
    "@vue/test-utils": "^2.4.10",
    "concurrently": "^10.0.0",
    "date-fns": "^4.4.0",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.9.1",
    "globals": "^17.6.0",
    "happy-dom": "^20.9.0",
    "http-server": "^14.1.1",
    "husky": "^9.1.7",
    "i18next": "^26.3.0",
    "lodash": "^4.18.1",
    "nuxt": "^4.4.6",
    "pinia": "^3.0.4",
    "prettier": "^3.8.3",
    "storybook": "^10.4.1",
    "stylelint": "^17.12.0",
    "stylelint-config-recommended": "^18.0.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.0",
    "unplugin-auto-import": "^21.0.0",
    "unplugin-vue-components": "^32.1.0",
    "vitest": "^4.1.7",
    "wait-on": "^9.0.10",
    "zod": "^4.4.3"
  }
}
